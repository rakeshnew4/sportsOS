# "local_json" (default) stores data in a local JSON file for dummy-data
# testing (see streamlit_app.py). Switch to "firestore" once ready for the
# real backend.
DATA_BACKEND=local_json
LOCAL_DATA_PATH=./local_data/store.json

# Only used when DATA_BACKEND=firestore.
# Path to the Firebase service account JSON (never commit the real file)
GOOGLE_APPLICATION_CREDENTIALS=./firebase_serviceaccount.json

# GCP/Firebase project id
FIRESTORE_PROJECT_ID=your-firebase-project-id

# Set only for local dev against the Firestore emulator, e.g. localhost:8080
# Leave unset to hit the real Firestore project above.
FIRESTORE_EMULATOR_HOST=

# Groq LLM API Key for AI-powered recommendations & notifications
# Get your key from https://console.groq.com
# IMPORTANT: Never commit your real key to version control
GROQ_API_KEY=your_groq_api_key_here

# Comma-separated list of origins allowed to call this API from a browser
# (the Next.js frontend's dev server, plus its deployed origin in prod).
CORS_ALLOW_ORIGINS=http://localhost:3000
